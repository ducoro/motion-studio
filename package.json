{
  "name": "ducoro-motion-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/register.ts --port=3142 --public-dir=assets",
    "render": "bun scripts/render.ts video",
    "stills": "bun scripts/render.ts stills",
    "typecheck": "tsc --noEmit",
    "verify": "bun test src/__tests__ && bun scripts/verify.ts",
    "test": "bun test src/__tests__",
    "checksums": "bun scripts/update-provenance.ts",
    "assets:prepare": "bun scripts/prepare-brand.ts && bun scripts/prepare-glass.ts && bun scripts/prepare-music.ts && bun scripts/update-provenance.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "6.0.3"
  },
  "description": "The source behind Ducoro\u2019s agent group film: oil paintings, curved glass, camera motion, and classical piano."
}
